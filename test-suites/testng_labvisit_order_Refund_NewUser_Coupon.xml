<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ============================================================
  Suite  : New User COD — Coupon + Cancellation Refund Flow
  Purpose: New user registers, places lab order with a coupon,
           order is cancelled and full refund validations run.
           Rewards steps are excluded (new users have none).
  ============================================================
-->
<suite name="New User COD Coupon + Refund Flow Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="New User COD Coupon Flow - With Cancel and Refund" preserve-order="true">
        <parameter name="userType"    value="new_user"/>
        <parameter name="flowType"    value="refund"/>
        <parameter name="orderType"   value="lab"/>
        <parameter name="applyCoupon" value="true"/>

        <classes>

            <!-- ── User Registration ──────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.auth.UserCreateAPITest">
                <methods>
                    <include name="testUserRegistration_CreateNewUser"/>
                </methods>
            </class>

            <!-- ── Login ──────────────────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods><include name="testLoginWithOTP_NewlyRegisteredUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>

            <!-- ── Tests & Packages ───────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest">
                <methods><include name="testGetLocations_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest">
                <methods><include name="testGetBrands_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.CatalogVerificationAPITest"/>

            <!-- ── Add to Cart WITH coupon (applyCoupon=true) ─────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.cart.AddToCartAPITest">
                <methods><include name="testAddToCart_ForNewUser"/></methods>
            </class>

            <!-- ── Coupon Validation — apply-and-verify steps ─────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.coupons.CouponComprehensiveTest">
                <methods>
                    <!-- Apply a valid coupon to cart and confirm it is accepted -->
                    <include name="TC_CPN_012_ApplyValidCouponSuccessfully"/>
                    <!-- Verify cart total is reduced by the coupon discount amount -->
                    <include name="TC_CPN_021_VerifyTotalPriceSubtraction"/>
                    <!-- Verify the remaining payable amount after coupon deduction -->
                    <include name="TC_CPN_017_ValidateRemainingPayableAfterCoupon"/>
                    <!-- Confirm coupon is still attached after slot/address update -->
                    <include name="TC_CPN_019_CouponPersistsInCart"/>
                    <!-- Verify coupon+admin cash split is correct -->
                    <include name="TC_CPN_018_ValidateCouponAndAdminCashSplit"/>
                </methods>
            </class>

            <!-- ── COD Flow ───────────────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.cart.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.slot.COD_03_AddLabSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_05_CrossApiValidationTest"/>

            <!-- ── Approve Payment ────────────────────────────────────────── -->
            <!-- NOTE: Rewards steps (step18_A/B/C) excluded — new users have no rewards -->
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_15_ApprovePaymentTest"/>

            <!-- ── Post-Cancellation Refund Flow ──────────────────────────── -->
            <!-- NOTE: step20_F (rewards verification) excluded — new users have no rewards -->
            <class name="com.mryoda.diagnostics.api.tests.order.COD_20_CancellationRefundTest">
                <methods>

                    <include name="step20_B_FinalUpdateOrderCancelled"/>

                    <include name="step20_D_VerifyCancelledOrderDetails"/>
                    <include name="step20_E_VerifyPaymentById"/>
                    <include name="step20_G_VerifyTransactionByMobile"/>
                </methods>
            </class>

        </classes>
    </test>

</suite>
