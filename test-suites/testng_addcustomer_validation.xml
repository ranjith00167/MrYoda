<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Add Customer API Validation Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <!-- ===================================================== -->
    <!-- SCENARIO: Add Customer API Positive Validation        -->
    <!-- ===================================================== -->

    <test name="Add Customer - Positive Validations" preserve-order="true">
        <parameter name="userType" value="member"/>
        <parameter name="flowType" value="validation"/>

        <classes>

            <!-- Login as Member -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods><include name="testLoginWithOTP"/></methods>
            </class>

            <!-- Add Customer Validation Tests -->
            <class name="com.mryoda.diagnostics.api.tests.customer.AddCustomerAPITest"/>

        </classes>
    </test>

</suite>
