<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Non-Member Home Collection Family Flow Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="Add Family Member COD Home sample collection Full Flow - Non Member" preserve-order="true">
        <parameter name="userType" value="non_member"/>
        <parameter name="flowType" value="full"/>

        <classes>
            <!-- 1. Login -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods>
                    <include name="testLoginWithOTP_NonMember"/>
                </methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>

            <!-- 2. Catalog & Discovery -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest">
                <methods><include name="testGetLocations_ForNonMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest">
                <methods><include name="testGetBrands_ForNonMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForNonMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.CatalogVerificationAPITest"/>

            <!-- 3. Add Family Member -->
            <class name="com.mryoda.diagnostics.api.tests.order.AddFamilyMemberTest"/>

            <!-- 4. Home Collection COD Flow -->
            <class name="com.mryoda.diagnostics.api.tests.cart.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.slot.COD_03_AddAddressAndSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_05_CrossApiValidationTest"/>
            
           <class name="com.mryoda.diagnostics.api.tests.order.COD_05_CrossApiValidationTest"/>
                       <class name="com.mryoda.diagnostics.api.tests.phlebio.PhlebioManagementTest">

                <methods>

                    <include name="PHLEBO_MGMT_01_LoginPhlebo"/>
                    <include name="PHLEBO_MGMT_02_AdminLogin"/>
                    <include name="PHLEBO_MGMT_03_AssignShifts"/>
                    <include name="PHLEBO_MGMT_04_GetPhleboShifts"/>
                    <include name="PHLEBO_MGMT_05_ClockIn"/>
                    <include name="PHLEBO_MGMT_06_AssignOrder"/>
                    <include name="PHLEBO_MGMT_07_UpdateOrderTracking"/>
                    <include name="PHLEBO_MGMT_08_UploadImage"/>
                    <include name="PHLEBO_MGMT_09_VerifyOtp"/>
                    <include name="PHLEBO_MGMT_10_GetSampleDetails"/>
                    <include name="PHLEBO_MGMT_11_GenerateBarcode"/>
                    <include name="PHLEBO_MGMT_12_UpdateOrderTrackingSamplesCollected"/>

                </methods>

            </class>

            <!-- 7. Approve Payment -->
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_15_ApprovePaymentTest"/>

   

            <!-- 8. UI Integration & Status -->
            <class name="com.mryoda.diagnostics.api.tests.ui_integration.COD_99_TriggerUITest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_16_VisitStatusAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_17_ReportGenerationTest"/>
        </classes>
    </test>
</suite>
