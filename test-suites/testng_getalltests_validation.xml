<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GetAllTests API Validation Suite" verbose="1" parallel="false">
    
    <parameter name="browser" value="chrome"/>
    
    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>
    
    <test name="GetAllTests Validation - Comprehensive" preserve-order="true">
        <classes>
            <!-- Prerequisites: Setup authentication and populate RequestContext -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods>
                    <exclude name="testLoginWithOTP_NewlyRegisteredUser"/>
                </methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>
            
            <!-- Get Location and Brand data -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest">
                <methods>
                    <include name="testGetLocations_ForNonMember"/>
                </methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest">
                <methods>
                    <include name="testGetBrands_ForNonMember"/>
                </methods>
            </class>
            
            <!-- Global Search to populate test data in RequestContext -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest">
                <methods>
                    <include name="testGlobalSearch_ForNonMember"/>
                </methods>
            </class>
            
            <!-- GetAllTests Validation Test Suite -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GetAllTestsValidationTest">
                <!-- All tests will run in priority order -->
            </class>
        </classes>
    </test>
    
</suite>
