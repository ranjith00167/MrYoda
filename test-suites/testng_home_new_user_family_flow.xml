<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="New User Home Collection Family Flow Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="Add Family Member COD Home sample collection Full Flow - New User" preserve-order="true">
        <parameter name="userType" value="new_user"/>
        <parameter name="flowType" value="full"/>

        <classes>
            <!-- 1. Registration & Login -->
            <class name="com.mryoda.diagnostics.api.tests.auth.UserCreateAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods>
                    <include name="testLoginWithOTP_NewlyRegisteredUser"/>
                </methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>

            <!-- 2. Catalog & Discovery -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest">
                <methods><include name="testGetLocations_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest">
                <methods><include name="testGetBrands_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForNewUser"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.CatalogVerificationAPITest"/>

            <!-- 3. Add Family Member -->
            <class name="com.mryoda.diagnostics.api.tests.order.AddFamilyMemberTest"/>

            <!-- 4. Home Collection COD Flow -->
            <class name="com.mryoda.diagnostics.api.tests.cart.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.slot.COD_03_AddAddressAndSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_05_CrossApiValidationTest"/>
            
            <!-- 5. Phlebotomist Workflow (Home Visit Specific) -->
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_06_PhlebotomistLoginTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_07_AssignOrderTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_08_VerifyStatusAssignedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_09_UpdateOrderTrackingTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_10_FinalVerificationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_11_AdminVerifyOtpTest"/>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.COD_12_GetSampleTypeTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_13_UpdateStatusSamplesCollectedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_14_VerifySamplesCollectedStatusTest"/>

            <!-- 6. Rewards -->
            <class name="com.mryoda.diagnostics.api.tests.rewards.COD_18_RewardValidationTest">
                <methods><include name="step18_A_VerifyInitialRewards"/></methods>
            </class>

            <!-- 7. Approve Payment -->
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_15_ApprovePaymentTest"/>

            <!-- Rewards -->
            <class name="com.mryoda.diagnostics.api.tests.rewards.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_B_VerifyRewardsGain"/>
                    <include name="step18_C_VerifyFinalRewardsBalance"/>
                </methods>
            </class>

            <!-- 8. UI Integration & Status -->
            <class name="com.mryoda.diagnostics.api.tests.ui_integration.COD_99_TriggerUITest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_16_VisitStatusAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_17_ReportGenerationTest"/>
        </classes>
    </test>
</suite>
