<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- ══════════════════════════════════════════════════════════════════════════
     FREE MEMBERSHIP — PAY ONLINE HYBRID SUITE
     ══════════════════════════════════════════════════════════════════════════
     Feature: TC_16__FreeMembership.feature
     Scenarios:
       1. Single Member – Lab Visit – Pay Online
       2. Single Member – Lab Visit – Reward + Coupon
       3. Multi Member – Reward + Coupon
       4. Multi Member – Reward Only
       5. Single Non-Member – Lab Visit – Pay Online
       6. Single New User – Lab Visit – Pay Online
       7. New User – Add Member – Lab Visit
       8. Add Member – Multi Lab Order – Membership
       9. Single Member – Coupon Only
      10. Single Non-Member – Coupon Only
      11. Multi Member – Coupon Only
      12. Multi Member Non-Member – Coupon Only
      13. Single Member – Reward Only

     Run:  mvn test "-DsuiteXmlFile=test-suites/testng_free_membership_suite.xml"
     ══════════════════════════════════════════════════════════════════════════ -->

<suite name="Free Membership Pay Online Hybrid Suite" verbose="2" parallel="false">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TEST : Free Membership — All Scenarios (Hybrid UI + API)           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <test name="Free Membership - All Scenarios" preserve-order="true">
        <parameter name="cucumber.filter.tags" value="@payOnlineHybrid"/>

        <classes>
            <class name="testRunner.FreeMembershipSuiteRunner"/>
        </classes>
    </test>

</suite>
