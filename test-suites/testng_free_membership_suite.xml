<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Free Membership Regression Suite" verbose="2" parallel="false">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <!-- ========================================================= -->
    <!-- FLOW 1 : Free Membership Order Creation Flow              -->
    <!-- ========================================================= -->
    <test name="FM_FLOW_01 - Order Creation" preserve-order="true">

        <parameter name="cucumber.filter.tags"
                   value="@hybridLabOrderMember"/>

        <classes>
            <class name="testRunner.FreeMembershipSuiteRunner"/>
        </classes>

    </test>

    <!-- ========================================================= -->
    <!-- FLOW 2 : Order Creation + Cancellation Flow               -->
    <!-- Independent Flow                                          -->
    <!-- Creates a fresh order and then cancels it                 -->
    <!-- ========================================================= -->
    <test name="FM_FLOW_02 - Order Creation And Cancellation"
          preserve-order="true">

        <parameter name="cucumber.filter.tags"
                   value="@hybridLabOrderMemberCancellation"/>

        <classes>
            <class name="testRunner.FreeMembershipSuiteRunner"/>
            <class name="com.mryoda.diagnostics.api.tests.order.FreeMembershipCancellationFlowTest"/>
        </classes>

    </test>

    <!-- ========================================================= -->
    <!-- FLOW 3 : Multi-Member Free Membership – Positive Flow     -->
    <!-- Creates 2 family members via API (Ranjith Kumar A,        -->
    <!-- Sathish Kumar) then places a multi-member lab order       -->
    <!-- ========================================================= -->
    <test name="FM_FLOW_03 - Multi Member Order Creation"
          preserve-order="true">

        <parameter name="cucumber.filter.tags"
                   value="@hybridLabOrderMemberMulti"/>

        <classes>
            <class name="testRunner.FreeMembershipSuiteRunner"/>
        </classes>

    </test>

    <!-- ========================================================= -->
    <!-- FLOW 4 : Multi-Member Free Membership – Cancellation Flow -->
    <!-- Same family-member creation + order, then full API        -->
    <!-- cancellation (Cashback → Cancel → Admin Approve)          -->
    <!-- ========================================================= -->
    <test name="FM_FLOW_04 - Multi Member Order Cancellation"
          preserve-order="true">

        <parameter name="cucumber.filter.tags"
                   value="@hybridLabOrderMemberMultiCancellation"/>

        <classes>
            <class name="testRunner.FreeMembershipSuiteRunner"/>
            <class name="com.mryoda.diagnostics.api.tests.order.FreeMembershipCancellationFlowTest"/>
        </classes>

    </test>



</suite>