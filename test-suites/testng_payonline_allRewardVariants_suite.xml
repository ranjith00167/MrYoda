    </classes>
  </test>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       SCENARIO 4: MULTI-MEMBER + REWARD + COUPON
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <test name="Scenario_4_MultiMember_Reward_Coupon">
    <parameter name="featureFile" value="src/test/resources/Feature/TC_11_PayOnline_HybridFlow.feature"/>
    <parameter name="tagFilter" value="@hybridMultiMemberRewardCoupon"/>
    <parameter name="scenario" value="MULTI_MEMBER_REWARD_COUPON"/>
    <parameter name="description" value="Multiple members place order with reward and coupon (proportional split)"/>
    <classes>
      <class name="testRunner.PayOnlineSuiteRunner"/>
    </classes>
  </test>

</suite>
