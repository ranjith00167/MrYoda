<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Report extraction / sync unit tests - offline, no staging access, no visit numbers.
  Run with : mvn test -DsuiteXmlFile=test-suites/testng_report_unit.xml
-->
<suite name="Report Extraction Unit Tests" verbose="1">
    <test name="PDF extraction, matching, polling">
        <classes>
            <class name="com.mryoda.diagnostics.api.report.PdfTextExtractorTest"/>
            <class name="com.mryoda.diagnostics.api.report.PdfResultMatcherTest"/>
            <class name="com.mryoda.diagnostics.api.report.ReportSnapshotTest"/>
            <class name="com.mryoda.diagnostics.api.report.LogRedactorTest"/>
            <class name="com.mryoda.diagnostics.api.report.ReportPollerTest"/>
        </classes>
    </test>
</suite>
