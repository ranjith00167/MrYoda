<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  ============================================================
  Suite  : Member COD — Multi-Member + Coupon | Cancel PRIMARY MEMBER Order
  Purpose: Primary member + one added family member place a combined
           lab order with a coupon applied (2 sub-orders created).
           After payment, the PRIMARY MEMBER's order (index 0) is
           cancelled — default currentOrderId, no context switch needed.
           Full refund + reward reversal + coupon discount validation
           runs for the primary member's cancelled order via COD-20.
           The FAMILY MEMBER's order (index 1) is unaffected.
  ============================================================
-->
<suite name="Member COD Multi-Member Coupon - Cancel Primary Member Order Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="Multi-Member COD Coupon - Cancel Primary Member Order + Refund" preserve-order="true">
        <parameter name="userType"   value="member"/>
        <parameter name="flowType"   value="refund"/>
        <parameter name="orderType"  value="lab"/>
        <!-- orderIndex=0 = primary member (default) — no switch needed; kept for clarity -->
        <parameter name="orderIndex" value="0"/>

        <classes>

            <!-- ── Login ──────────────────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                <methods><include name="testLoginWithOTP"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>

            <!-- ── Tests & Packages ───────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest">
                <methods><include name="testGetLocations_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest">
                <methods><include name="testGetBrands_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.CatalogVerificationAPITest"/>

            <!-- ── Multi-Member Cart: Add Family Member + add items for both ── -->
            <class name="com.mryoda.diagnostics.api.tests.order.AddFamilyMemberTest">
                <methods><include name="testAddFamilyMemberAndAddToCart"/></methods>
            </class>

            <!-- ── Coupon: Discover + Apply to multi-member cart ──────────── -->
            <class name="com.mryoda.diagnostics.api.tests.coupons.CouponMultiMemberTest">
                <methods>
                    <include name="step01_DiscoverCoupon"/>
                    <include name="step02_ApplyCouponToMultiMemberCart"/>
                </methods>
            </class>

            <!-- ── COD Flow ───────────────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.cart.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.slot.COD_03_AddLabSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_05_CrossApiValidationTest"/>

            <!-- ── Rewards Before Payment ─────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.rewards.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_A_VerifyInitialRewards"/>
                </methods>
            </class>

            <!-- ── Approve Payment ────────────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.payment.COD_15_ApprovePaymentTest"/>

            <!-- ── Rewards After Payment ──────────────────────────────────── -->
            <class name="com.mryoda.diagnostics.api.tests.rewards.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_B_VerifyRewardsGain"/>
                    <include name="step18_C_VerifyFinalRewardsBalance"/>
                </methods>
            </class>

            <!-- ── No order switch — currentOrderId is already index 0 ──────── -->
            <!-- (primary member's order is the default after setCurrentOrderIds) -->

            <!-- ── Cancel PRIMARY MEMBER's order + verify before/after ──────── -->
            <class name="com.mryoda.diagnostics.api.tests.order.COD_19_OrderCancellationTest">
                <methods>
                    <include name="step19_A_VerifyOrderBeforeCancellation"/>
                    <include name="step19_B_CancelOrder"/>
                    <include name="step19_C_VerifyOrderAfterCancellation"/>
                </methods>
            </class>

            <!-- ── Post-Cancellation Refund + Reward Reversal Validation ──── -->
            <!-- Validates the PRIMARY MEMBER's cancelled order                 -->
            <!-- step20_D: actual_discount == membership_discount + coupon_discount_amount -->
            <!-- step20_F: rewards earned at placement are reversed             -->
            <!-- step20_G: verifies both Success + Cancelled transaction records -->
            <class name="com.mryoda.diagnostics.api.tests.order.COD_20_CancellationRefundTest">
                <methods>
                    <include name="step20_A_ProcessCashback"/>
                    <include name="step20_B_FinalUpdateOrderCancelled"/>

                    <include name="step20_D_VerifyCancelledOrderDetails"/>
                    <include name="step20_E_VerifyPaymentById"/>
                    <include name="step20_F_VerifyRewardsByMobile"/>
                    <include name="step20_G_VerifyTransactionByMobile"/>
                </methods>
            </class>

        </classes>
    </test>

</suite>
