<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Phlebio Management Regression Suite"
       verbose="2"
       parallel="none">

    <!-- =========================
         LISTENERS
    ========================== -->
    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <!-- =========================
         POSITIVE SCENARIOS
    ========================== -->
    <test name="Phlebio Management Positive Scenarios"
          preserve-order="true">

        <classes>

            <class name="com.mryoda.diagnostics.api.tests.phlebio.PhlebioManagementTest">

                <methods>

                    <include name="PHLEBO_MGMT_01_LoginPhlebo"/>
                    <include name="PHLEBO_MGMT_02_AdminLogin"/>
                    <include name="PHLEBO_MGMT_03_AssignShifts"/>
                    <include name="PHLEBO_MGMT_04_GetPhleboShifts"/>
                    <include name="PHLEBO_MGMT_05_ClockIn"/>

                </methods>

            </class>

        </classes>

    </test>

    <!-- =========================
         NEGATIVE SCENARIOS
    ========================== -->
    <test name="Phlebio Management Negative Scenarios"
          preserve-order="true">

        <classes>

            <class name="com.mryoda.diagnostics.api.tests.phlebio.PhlebioManagementNegativeTest">

                <methods>

                    <!-- Assign Shifts -->
                    <include name="PHLEBO_MGMT_NEG_01_AssignShiftsNoAuth"/>
                    <include name="PHLEBO_MGMT_NEG_02_AssignShiftsInvalidToken"/>
                    <include name="PHLEBO_MGMT_NEG_03_AssignShiftsEmptyGuids"/>
                    <include name="PHLEBO_MGMT_NEG_04_AssignShiftsBadDate"/>
                    <include name="PHLEBO_MGMT_NEG_05_AssignShiftsMissingSlots"/>

                    <!-- Get Phlebo Shifts -->
                    <include name="PHLEBO_MGMT_NEG_06_GetShiftsNoAuth"/>
                    <include name="PHLEBO_MGMT_NEG_07_GetShiftsInvalidToken"/>
                    <include name="PHLEBO_MGMT_NEG_08_GetShiftsNonExistentGuid"/>

                    <!-- Clock In -->
                    <include name="PHLEBO_MGMT_NEG_09_ClockInNoAuth"/>
                    <include name="PHLEBO_MGMT_NEG_10_ClockInInvalidToken"/>
                    <include name="PHLEBO_MGMT_NEG_11_ClockInMissingImageUrl"/>

                </methods>

            </class>

        </classes>

    </test>

</suite>
