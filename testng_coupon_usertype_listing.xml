<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Coupon UserType Listing Suite" parallel="none" verbose="2">
    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="Prime vs NonPrime Coupon Listing" preserve-order="true">
        <classes>
            <class name="com.mryoda.diagnostics.api.tests.coupons.CouponValidationTest">
                <methods>
                    <include name="testGetAllCoupons_Prime"/>
                    <include name="testGetAllCoupons_NonPrime"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
