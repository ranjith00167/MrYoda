<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Family Member Flow Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <test name="Family Member Add &amp; verification" preserve-order="true">
        <parameter name="userType" value="member"/>

        <classes>
            <!-- 1. Ensure Login / Context -->
            <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest">
                 <methods><include name="testLoginWithOTP"/></methods>
            </class>
            
            <!-- 2. Family Member Flow -->
            <class name="com.mryoda.diagnostics.api.tests.family.FamilyMemberFlowTest"/>

        </classes>
    </test>

</suite>
