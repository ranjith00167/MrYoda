<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Temp NewUser Coupon Precheck Debug" verbose="2" preserve-order="true">
  <test name="NewUser Flow To VerifyPayment">
    <parameter name="userType" value="new_user"/>
    <parameter name="applyCoupon" value="true"/>
    <parameter name="orderType" value="home"/>
    <classes>
      <class name="com.mryoda.diagnostics.api.tests.auth.UserCreateAPITest"><methods><include name="testUserRegistration_CreateNewUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.auth.LoginAPITest"><methods><include name="testLoginWithOTP_NewlyRegisteredUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.auth.COD_01_LoginTest"/>
      <class name="com.mryoda.diagnostics.api.tests.tests_packages.LocationAPITest"><methods><include name="testGetLocations_ForNewUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.tests_packages.BrandAPITest"><methods><include name="testGetBrands_ForNewUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.tests_packages.GlobalSearchAPITest"><methods><include name="testGlobalSearch_ForNewUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.cart.AddToCartAPITest"><methods><include name="testAddToCart_ForNewUser"/></methods></class>
      <class name="com.mryoda.diagnostics.api.tests.cart.COD_02_GetCartTest"/>
      <class name="com.mryoda.diagnostics.api.tests.slot.COD_03_AddAddressAndSlotTest"/>
      <class name="com.mryoda.diagnostics.api.tests.payment.COD_04_VerifyPaymentPreCheckTest"/>
    </classes>
  </test>
</suite>
