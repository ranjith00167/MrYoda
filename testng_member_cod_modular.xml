<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Member COD Two Scenario Suite" verbose="2">

    <listeners>
        <listener class-name="utilities.TestNGExtentReportListener"/>
    </listeners>

    <!-- ===================================================== -->
    <!-- SCENARIO 1 — FULL FLOW (NO ORDER CANCELLATION)       -->
    <!-- ===================================================== -->

    <test name="Member COD Full Flow - No Cancel" preserve-order="true">
        <parameter name="userType" value="member"/>
        <parameter name="flowType" value="full"/>

        <classes>

            <!-- Login -->
            <class name="com.mryoda.diagnostics.api.tests.LoginAPITest">
                <methods><include name="testLoginWithOTP"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.COD_01_LoginTest"/>

            <!-- Data Setup -->
            <class name="com.mryoda.diagnostics.api.tests.LocationAPITest">
                <methods><include name="testGetLocations_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.BrandAPITest">
                <methods><include name="testGetBrands_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.CatalogVerificationAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.AddToCartAPITest">
                <methods><include name="testAddToCart_ForMember"/></methods>
            </class>

            <!-- COD Flow -->
            <class name="com.mryoda.diagnostics.api.tests.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_03_AddAddressAndSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_05_CrossApiValidationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_06_PhlebotomistLoginTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_07_AssignOrderTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_08_VerifyStatusAssignedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_09_UpdateOrderTrackingTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_10_FinalVerificationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_11_AdminVerifyOtpTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_12_GetSampleTypeTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_13_UpdateStatusSamplesCollectedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_14_VerifySamplesCollectedStatusTest"/>

            <!-- Rewards Before Payment -->
            <class name="com.mryoda.diagnostics.api.tests.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_A_VerifyInitialRewards"/>
                </methods>
            </class>

            <!-- Approve Payment -->
            <class name="com.mryoda.diagnostics.api.tests.COD_15_ApprovePaymentTest"/>

            <!-- Rewards After Payment -->
            <class name="com.mryoda.diagnostics.api.tests.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_B_VerifyRewardsGain"/>
                    <include name="step18_C_VerifyFinalRewardsBalance"/>
                </methods>
            </class>

            <!-- Continue Full Flow -->
            <class name="com.mryoda.diagnostics.api.tests.COD_99_TriggerUITest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_16_VisitStatusAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_17_ReportGenerationTest"/>

        </classes>
    </test>


    <!-- ===================================================== -->
    <!-- SCENARIO 2 — FLOW TILL ORDER CANCELLATION            -->
    <!-- ===================================================== -->

    <test name="Member COD Flow - Till Cancel" preserve-order="true">
        <parameter name="userType" value="member"/>
        <parameter name="flowType" value="cancel"/>

        <classes>

            <!-- Login -->
            <class name="com.mryoda.diagnostics.api.tests.LoginAPITest">
                <methods><include name="testLoginWithOTP"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.COD_01_LoginTest"/>

            <!-- Data Setup -->
            <class name="com.mryoda.diagnostics.api.tests.LocationAPITest">
                <methods><include name="testGetLocations_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.BrandAPITest">
                <methods><include name="testGetBrands_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.GlobalSearchAPITest">
                <methods><include name="testGlobalSearch_ForMember"/></methods>
            </class>
            <class name="com.mryoda.diagnostics.api.tests.CatalogVerificationAPITest"/>
            <class name="com.mryoda.diagnostics.api.tests.AddToCartAPITest">
                <methods><include name="testAddToCart_ForMember"/></methods>
            </class>

            <!-- COD Flow -->
            <class name="com.mryoda.diagnostics.api.tests.COD_02_GetCartTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_03_AddAddressAndSlotTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_04_VerifyPaymentPreCheckTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_05_CrossApiValidationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_06_PhlebotomistLoginTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_07_AssignOrderTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_08_VerifyStatusAssignedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_09_UpdateOrderTrackingTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_10_FinalVerificationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_11_AdminVerifyOtpTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_12_GetSampleTypeTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_13_UpdateStatusSamplesCollectedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.COD_14_VerifySamplesCollectedStatusTest"/>


            <!-- Rewards + Payment -->
            <class name="com.mryoda.diagnostics.api.tests.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_A_VerifyInitialRewards"/>
                </methods>
            </class>

            <class name="com.mryoda.diagnostics.api.tests.COD_15_ApprovePaymentTest"/>

            <class name="com.mryoda.diagnostics.api.tests.COD_18_RewardValidationTest">
                <methods>
                    <include name="step18_B_VerifyRewardsGain"/>
                    <include name="step18_C_VerifyFinalRewardsBalance"/>
                </methods>
            </class>

            <!-- Cancel Order -->
            <class name="com.mryoda.diagnostics.api.tests.COD_19_OrderCancellationTest"/>

        </classes>
    </test>

</suite>
