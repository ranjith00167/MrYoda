            <class name="com.mryoda.diagnostics.api.tests.auth.COD_06_PhlebotomistLoginTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_07_AssignOrderTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_08_VerifyStatusAssignedTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_09_UpdateOrderTrackingTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_10_FinalVerificationTest"/>
            <class name="com.mryoda.diagnostics.api.tests.order.COD_11_AdminVerifyOtpTest"/>
            <class name="com.mryoda.diagnostics.api.tests.tests_packages.COD_12_GetSampleTypeTest"/>
